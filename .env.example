HOST=127.0.0.1
PORT=4173
SHIPWITNESS_STORE_FILE=./data/store.json
SHIPWITNESS_ARTIFACTS_DIR=./data/evidence
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Generate once with: openssl rand -base64 32
SHIPWITNESS_MASTER_KEY=replace-with-a-base64-encoded-32-byte-key
# Optional deployment override; always pin an exact version, never latest.
# SHIPWITNESS_IMAGE=shipwitness:0.4.0-dev.27
# Comma-separated exact origins. Loopback origins are allowed automatically.
# SHIPWITNESS_ALLOWED_TARGET_ORIGINS=https://staging.example.com,https://assets.example.com
# DATABASE_URL=postgresql://shipwitness:password@127.0.0.1:5432/shipwitness
# Optional for private repository sync and GitHub Issue export. Use a fine-grained token scoped to selected repositories.
# Read sync needs Contents, Commit statuses, and Checks read; Issue export additionally needs Issues write.
# GITHUB_TOKEN=server-only-fine-grained-token
# Required for automatic GitHub push/CI synchronization. Generate a separate high-entropy secret and configure the same value in the GitHub repository webhook.
# SHIPWITNESS_GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
# Required for links in invitation and task emails. Use the externally reachable HTTPS origin in production.
# SHIPWITNESS_PUBLIC_URL=https://shipwitness.example.com
# Optional evidence metadata shown in the owner-only readiness center.
# Record only a timestamp after backup verification has actually succeeded.
# SHIPWITNESS_LAST_VERIFIED_BACKUP_AT=2026-08-28T00:00:00Z
# Reference an independent review ticket or report; do not put report contents or credentials here.
# SHIPWITNESS_SECURITY_REVIEW_REFERENCE=security-review-2026-08
# ISO timestamp for the completion date of that independent review. Reviews older than one year return to warning state.
# SHIPWITNESS_SECURITY_REVIEWED_AT=2026-08-28T00:00:00Z
# Stable 1.x releases must publish both timestamps. Development builds remain evaluation-only regardless of these values.
# SHIPWITNESS_RELEASED_AT=2026-08-28T00:00:00Z
# SHIPWITNESS_END_OF_SUPPORT_AT=2027-08-28T00:00:00Z
# SMTP is disabled unless both HOST and FROM are set.
# SHIPWITNESS_SMTP_HOST=smtp.example.com
# SHIPWITNESS_SMTP_PORT=587
# SHIPWITNESS_SMTP_SECURE=false
# SHIPWITNESS_SMTP_REQUIRE_TLS=true
# SHIPWITNESS_SMTP_FROM=ShipWitness <shipwitness@example.com>
# SHIPWITNESS_SMTP_USER=
# SHIPWITNESS_SMTP_PASSWORD=
